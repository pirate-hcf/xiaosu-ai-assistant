<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaosu.mapper.DocumentMapper">

    <resultMap id="documentResult" type="com.xiaosu.domain.DocumentRecord">
        <constructor>
            <idArg column="id" javaType="java.util.UUID"
                   typeHandler="com.xiaosu.mapper.typehandler.UuidTypeHandler"/>
            <arg column="canonical_name" javaType="java.lang.String"/>
            <arg column="active_version_id" javaType="java.util.UUID"
                 typeHandler="com.xiaosu.mapper.typehandler.UuidTypeHandler"/>
            <arg column="deleted_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO documents (
            id, canonical_name, active_version_id, deleted_at, created_at, updated_at
        ) VALUES (
            #{id}, #{canonicalName}, #{activeVersionId,jdbcType=CHAR},
            #{deletedAt,jdbcType=TIMESTAMP}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <select id="findById" resultMap="documentResult">
        SELECT * FROM documents WHERE id = #{id}
    </select>

    <select id="findByCanonicalName" resultMap="documentResult">
        SELECT * FROM documents WHERE canonical_name = #{canonicalName}
    </select>

    <select id="findAllNotDeleted" resultMap="documentResult">
        SELECT * FROM documents
        WHERE deleted_at IS NULL
        ORDER BY created_at DESC, canonical_name
    </select>

    <update id="setActiveVersion">
        UPDATE documents
        SET active_version_id = #{versionId}, updated_at = #{updatedAt}
        WHERE id = #{documentId}
    </update>

    <update id="markDeleted">
        UPDATE documents
        SET deleted_at = #{deletedAt}, active_version_id = NULL, updated_at = #{deletedAt}
        WHERE id = #{documentId}
    </update>
</mapper>
